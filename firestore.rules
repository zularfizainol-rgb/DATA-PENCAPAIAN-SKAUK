rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidPencapaian(data) {
      return data.keys().hasAll(['nama', 'noKp', 'aliran', 'kelas', 'bahagian', 'pertandingan', 'statusPertandingan', 'peringkat', 'pencapaian', 'tahunKalendar', 'updatedAt', 'creatorId'])
        && data.keys().hasOnly([
          'nama', 'noKp', 'aliran', 'kelas', 'bahagian', 'pertandingan',
          'statusPertandingan', 'peringkat', 'pencapaian', 'tahunKalendar',
          'updatedAt', 'creatorId',
          'jenisTarikh', 'tarikhMula', 'tarikhTamat',
          'suratPengiktirafanNama', 'suratPengiktirafanData',
          'sijilMuridNama', 'sijilMuridData',
          'guruPengiring'
        ])
        && data.nama is string && data.nama.size() > 0 && data.nama.size() <= 200
        && data.noKp is string && data.noKp.size() <= 20
        && data.aliran is string && data.aliran.size() <= 50
        && data.kelas is string && data.kelas.size() <= 50
        && data.bahagian is string && data.bahagian.size() <= 100
        && data.pertandingan is string && data.pertandingan.size() > 0 && data.pertandingan.size() <= 200
        && data.statusPertandingan is string && data.statusPertandingan.size() <= 50
        && data.peringkat is string && data.peringkat.size() <= 50
        && data.pencapaian is string && data.pencapaian.size() <= 50
        && data.tahunKalendar is string && data.tahunKalendar.size() == 4
        && data.updatedAt is timestamp
        && data.creatorId is string && data.creatorId.size() <= 128
        && (!('jenisTarikh' in data) || (data.jenisTarikh is string && data.jenisTarikh.size() <= 20))
        && (!('tarikhMula' in data) || (data.tarikhMula is string && data.tarikhMula.size() <= 20))
        && (!('tarikhTamat' in data) || (data.tarikhTamat is string && data.tarikhTamat.size() <= 20))
        && (!('suratPengiktirafanNama' in data) || (data.suratPengiktirafanNama is string && data.suratPengiktirafanNama.size() <= 255))
        && (!('suratPengiktirafanData' in data) || (data.suratPengiktirafanData is string && data.suratPengiktirafanData.size() <= 700000))
        && (!('sijilMuridNama' in data) || (data.sijilMuridNama is string && data.sijilMuridNama.size() <= 255))
        && (!('sijilMuridData' in data) || (data.sijilMuridData is string && data.sijilMuridData.size() <= 700000))
        && (!('guruPengiring' in data) || (data.guruPengiring is list && data.guruPengiring.size() <= 20));
    }

    match /pencapaian/{pencapaianId} {
      allow read: if true;
      
      allow create: if true
        && isValidId(pencapaianId)
        && isValidPencapaian(incoming())
        && incoming().updatedAt == request.time;
        
      allow update: if true
        && isValidId(pencapaianId)
        && isValidPencapaian(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'nama', 'noKp', 'aliran', 'kelas', 'bahagian', 'pertandingan',
          'statusPertandingan', 'peringkat', 'pencapaian', 'tahunKalendar',
          'updatedAt',
          'jenisTarikh', 'tarikhMula', 'tarikhTamat',
          'suratPengiktirafanNama', 'suratPengiktirafanData',
          'sijilMuridNama', 'sijilMuridData',
          'guruPengiring'
        ])
        && incoming().creatorId == existing().creatorId
        && incoming().updatedAt == request.time;

      allow delete: if true;
    }
  }
}
